# PostgreSQL Environment Variables for Docker Compose Development
# Copy this file to .env in the docker directory and adjust values as needed

# Database Configuration
POSTGRES_DB=testdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Additional PostgreSQL Configuration
POSTGRES_LOG_STATEMENT=all
POSTGRES_LOG_DURATION=on

# Optional: Custom PostgreSQL settings
# Uncomment and modify as needed
# POSTGRES_SHARED_PRELOAD_LIBRARIES=
# POSTGRES_MAX_CONNECTIONS=100
# POSTGRES_SHARED_BUFFERS=128MB

# Application Environment (for pg-genrole service)
# These will be used when running the pg-genrole container
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=testdb

# Development Settings
# Set to 'true' to enable verbose logging
DEBUG=false

# Container Settings
# Uncomment to customize container behavior
# RESTART_POLICY=unless-stopped
# POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=trust

# Networking
# Uncomment to customize network settings
# POSTGRES_NETWORK=pg-genrole-network

# Volume Settings
# Uncomment to use custom volume names
# POSTGRES_DATA_VOLUME=postgres_data